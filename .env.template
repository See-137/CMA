# CMA - Cost Monitoring Agent Configuration
# Copy this file to .env and customize.
# Backend settings are read by pydantic-settings and MUST use the CMA_ prefix.

# Backend
CMA_DATABASE_URL=sqlite:///./data/cma.db
CMA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM provider for the Scrooge chat assistant (openai | ollama)
CMA_LLM_PROVIDER=ollama
CMA_LLM_MODEL=llama3
# CMA_OPENAI_API_KEY=sk-...
# CMA_OLLAMA_BASE_URL=http://localhost:11434

# Abuse / safety limits
CMA_MAX_EVENTS_PER_REQUEST=1000
CMA_RATE_LIMIT_LOGIN_PER_MINUTE=10
CMA_RATE_LIMIT_CHAT_PER_MINUTE=30

# Set false on all but one worker/replica so the daily maintenance loop
# (rollups/prune/embed) runs on exactly one process.
CMA_ENABLE_MAINTENANCE=true

# Allow alert webhooks to target private/loopback hosts (SSRF guard off).
# Only enable if you point alerts at a localhost dev endpoint.
CMA_ALLOW_PRIVATE_WEBHOOKS=false

# Postgres password for docker-compose (prod). Leave unset for the dev default.
# POSTGRES_PASSWORD=

# Frontend (Vite dev server)
VITE_API_URL=http://localhost:8000
