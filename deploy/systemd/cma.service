# CMA - Cost Monitoring Agent, native (non-Docker) deploy.
# Single process serves the API and, when CMA_SERVE_STATIC_DIR is set in the
# EnvironmentFile, the built frontend as well. Binds localhost only — access
# the dashboard over an SSH tunnel (ssh -L 8000:127.0.0.1:8000 <host>).
#
# Install (checkout at /opt/cma, venv at /opt/cma/.venv):
#   sudo useradd --system --home /opt/cma --shell /usr/sbin/nologin cma
#   sudo chown -R cma:cma /opt/cma
#   sudo chmod 600 /opt/cma/.env        # holds API keys — keep it private
#   sudo cp cma.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cma

[Unit]
Description=CMA - Cost Monitoring Agent
After=network-online.target
Wants=network-online.target
# Stop true crash loops without tripping on transient flaps.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cma
Group=cma
WorkingDirectory=/opt/cma/backend
EnvironmentFile=/opt/cma/.env
# sentence-transformers downloads the embedding model on first run; keep the
# cache inside the data dir so it is the only writable path besides the DB.
Environment=HF_HOME=/opt/cma/backend/data/hf
# Alembic owns the schema — migrate before every start (idempotent).
ExecStartPre=/opt/cma/.venv/bin/alembic upgrade head
ExecStart=/opt/cma/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# Hardening. The process holds a plaintext ingest key (SetupConfig.api_key)
# and writes only its data dir (SQLite/Chroma/logs + the model cache above).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cma/backend/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
